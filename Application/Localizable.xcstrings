{
  "sourceLanguage": "en",
  "strings": {
    " Became Active!": {
      "comment": " Became Active!",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Se activó!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": " ενεργοποιήθηκε!"
          }
        }
      }
    },
    " Became Inactive.": {
      "comment": " Became Inactive.",
      "localizations": {
