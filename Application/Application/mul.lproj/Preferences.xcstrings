{
  "sourceLanguage": "en",
  "strings": {
    "1A2-j2-kqG.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"Do not show an alert when the camera/microphone is deactivated.  \"; ObjectID = \"1A2-j2-kqG\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Do not show an alert when the camera/microphone is deactivated.  "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No mostrar una alerta cuando la cámara/micrófono se desactiven."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να μην εμφανίζεται ειδοποίηση όταν απενεργοποιείται η κάμερα ή το μικρόφωνο.  "
          }
        }
      }
    },
