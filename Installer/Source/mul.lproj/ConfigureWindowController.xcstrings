    "WLJ-8f-ExO.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"It's free, open-source, and written by a single (mac-loving) coder!\"; ObjectID = \"WLJ-8f-ExO\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "It's free, open-source, and written by a single (mac-loving) coder!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cargo, open-source y desarrollado por un único programador (amante de Mac)!  "
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι δωρεάν, ανοιχτού κώδικα και δημιουργήθηκε από έναν μόνο προγραμματιστή που αγαπά τα Mac!"
          }
        }
      }
    },
    "zdX-7L-hfX.title": {
      "comment": "Class = \"NSTextFieldCell\"; title = \"If \\\"Do Not Disturb\\\" mode is activated, OverSight's alerts won't be shown\"; ObjectID = \"zdX-7L-hfX\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "If \"Do Not Disturb\" mode is activated, OverSight's alerts won't be shown"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el modo \"No Molestar\" está activado, las alertas de OverSight no se mostrarán"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν είναι ενεργή η λειτουργία «Μην ενοχλείτε», δεν θα εμφανίζονται οι ειδοποιήσεις του OverSight."
          }
        }
      }
    }
