    "error: failed to load patrons :/": {
      "comment": "error: failed to load patrons :/",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "error: no se pudieron cargar los patrons :/"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "σφάλμα: αποτυχία φόρτωσης υποστηρικτών :/"
          }
        }
      }
    },
    "ERROR: failed to terminate %@ (%@)": {
      "comment": "ERROR: failed to terminate %@ (%@)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "ERROR: failed to terminate %1$@ (%2$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: no se pudo terminar %1$@ (%2$@)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "ΣΦΑΛΜΑ: αποτυχία τερματισμού %1$@ (%2$@)"
          }
        }
      }
    },
    "ERROR: OverSight is not authorized to display notifications.": {
      "comment": "ERROR: OverSight is not authorized to display notifications.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: OverSight no está autorizado para mostrar notificaciones."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "ΣΦΑΛΜΑ: Το OverSight δεν έχει άδεια εμφάνισης γνωστοποιήσεων."
          }
        }
      }
    },
    "Error: update check failed": {
      "comment": "Error: update check failed",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error: la verificación de actualización falló"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σφάλμα: απέτυχε ο έλεγχος ενημερώσεων"
          }
        }
      }
    },
    "Installed version (%@),\r\nis the latest.": {
      "comment": "Installed version (%@),\r\nis the latest.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión instalada (%@) es la más reciente."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγκατεστημένη έκδοση (%@)\r\nείναι η πιο πρόσφατη."
          }
        }
      }
    },
    "No Active Devices": {
      "comment": "No Active Devices",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay Dispositivos Activos"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καμία ενεργή συσκευή"
          }
        }
      }
    },
    "Open System Preferences...": {
      "comment": "Open System Preferences...",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Preferencias del Sistema..."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιγμα Ρυθμίσεων συστήματος…"
          }
        }
      }
    },
    "OverSight notification mode set to %@.": {
      "comment": "OverSight notification mode set to %@.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de notificación de OverSight configurado en %@."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λειτουργία γνωστοποιήσεων του OverSight ορίστηκε σε %@."
          }
        }
      }
    },
    "pid: unknown": {
      "comment": "pid: unknown",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "pid: desconocido"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "pid: άγνωστο"
          }
        }
      }
    },
    "Please authorize (style: \"Alerts\") via the Notifications pane in System Preferences.": {
      "comment": "Please authorize (style: \"Alerts\") via the Notifications pane in System Preferences.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, autoriza (estilo: \"Alertas\") a través del panel de Notificaciones en Preferencias del Sistema."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίτρεψε τις γνωστοποιήσεις (στιλ: «Ειδοποιήσεις») από τις Ρυθμίσεις συστήματος → Γνωστοποιήσεις."
          }
        }
      }
    },
    "Please change to \"Alerts\" via the Notifications pane in System Preferences.": {
      "comment": "Please change to \"Alerts\" via the Notifications pane in System Preferences.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, cambia a \"Alertas\" a través del panel de Notificaciones en Preferencias del Sistema."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επίλεξε «Ειδοποιήσεις» στις Ρυθμίσεις συστήματος → Γνωστοποιήσεις."
          }
        }
      }
    },
    "Process: %@ (%@)": {
      "comment": "Process: %@ (%@)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Process: %1$@ (%2$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proceso: %1$@ (%2$@)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διεργασία: %1$@ (%2$@)"
          }
        }
      }
    },
    "system error code: %d": {
      "comment": "system error code: %d",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "código de error del sistema: %d"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "κωδικός σφάλματος συστήματος: %d"
          }
        }
      }
    },
    "unknown": {
      "comment": "unknown",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "desconocido"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "άγνωστο"
          }
        }
      }
    },
    "Update": {
      "comment": "Update",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενημέρωση"
          }
        }
      }
    },
    "Update available, but isn't supported on macOS %ld.%ld": {
      "comment": "Update available, but isn't supported on macOS %ld.%ld",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Update available, but isn't supported on macOS %1$ld.%2$ld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización disponible, pero no es compatible con macOS %1$ld.%2$ld"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Υπάρχει διαθέσιμη ενημέρωση, αλλά δεν υποστηρίζεται στο macOS %1$ld.%2$ld"
          }
        }
      }
