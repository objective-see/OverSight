{
  "sourceLanguage": "en",
  "strings": {
    "☑️ %@: installed!\n": {
      "comment": "☑️ %@: installed!\n",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "☑️ %@: ¡instalado!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "☑️ %@: εγκαταστάθηκε!\n"
          }
        }
      }
    },
    "☑️ %@: uninstalled!\n": {
      "comment": "☑️ %@: uninstalled!\n",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "☑️ %@: ¡desinstalado!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "☑️ %@: απεγκαταστάθηκε!\n"
          }
        }
      }
    },
    "⚠️ Error: %@ failed": {
      "comment": "⚠️ Error: %@ failed",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Error: %@ falló"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Σφάλμα: αποτυχία του %@"
          }
        }
      }
    },
    "Close": {
      "comment": "Close",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλείσιμο"
          }
        }
      }
    },
    "ERROR: Insuffient Privileges.": {
      "comment": "ERROR: Insuffient Privileges.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR: Privilegios Insuficientes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "ΣΦΑΛΜΑ: Ανεπαρκή δικαιώματα."
          }
        }
      }
    },
    "Exit": {
      "comment": "Exit",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έξοδος"
          }
        }
      }
    },
    "For more info, from the terminal run:\r\nlog show --predicate=\"subsystem='com.objective-see.oversight'\"": {
      "comment": "For more info, from the terminal run:\r\nlog show --predicate=\"subsystem='com.objective-see.oversight'\"",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para más información, ejecuta en la terminal:\nlog show --predicate=\"subsystem='com.objective-see.oversight'"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για περισσότερες πληροφορίες, εκτέλεσε στο Τερματικό:\r\nlog show --predicate=\"subsystem='com.objective-see.oversight'\""
          }
        }
      }
    },
    "install": {
      "comment": "install",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "instalar"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "εγκατάσταση"
          }
        }
      }
    },
    "Installing...": {
      "comment": "Installing...",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalando..."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εγκατάσταση…"
          }
        }
      }
    },
    "Next »": {
      "comment": "Next »",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente »"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επόμενο »"
          }
        }
